      <sparkle:version>1</sparkle:version>
      <sparkle:shortVersionString>1.0</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
      <description><![CDATA[<p>First release of Grumlin: a little gremlin in your menu bar that keeps your Mac awake. Timers, until a time, until a process finishes, Keep Display Awake, midnight pizza. In English, Simplified Chinese and Japanese.</p>]]></description>
